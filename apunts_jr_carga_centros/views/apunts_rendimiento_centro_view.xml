<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="apunts_rendimiento_centro_list" model="ir.ui.view">
        <field name="name">apunts.rendimiento.centro.list</field>
        <field name="model">apunts.rendimiento.centro.line</field>
        <field name="arch" type="xml">
            <list string="Rendimiento por centro" create="0" delete="0" edit="0"
                  decoration-success="rendimiento &gt;= 1"
                  decoration-warning="rendimiento &lt; 1 and rendimiento &gt;= 0.75"
                  decoration-danger="rendimiento &lt; 0.75">
                <field name="workcenter_id" string="Centro"/>
                <field name="horas_fichadas" string="Horas fichadas" sum="Total"/>
                <field name="horas_previstas" string="Horas previstas" sum="Total"/>
                <field name="rendimiento" string="Rendimiento"/>
                <field name="n_ot" string="OT terminadas" sum="Total"/>
                <field name="llega" string="Llega a 1" optional="hide"/>
                <field name="user_id" column_invisible="1"/>
                <button name="action_open_fichajes" type="object" icon="fa-external-link"
                        string="Ver fichajes" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="apunts_rendimiento_centro_graph" model="ir.ui.view">
        <field name="name">apunts.rendimiento.centro.graph</field>
        <field name="model">apunts.rendimiento.centro.line</field>
        <field name="arch" type="xml">
            <graph string="Rendimiento por centro" type="bar" sample="1">
                <field name="workcenter_id"/>
                <field name="rendimiento" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="apunts_action_rendimiento_centro_srv" model="ir.actions.server">
        <field name="name">Rendimiento por centro</field>
        <field name="model_id" ref="model_apunts_rendimiento_centro"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

</odoo>
