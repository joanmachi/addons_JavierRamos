<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="apunts_cmp_indicador_list" model="ir.ui.view">
        <field name="name">apunts.cmp.indicador.list</field>
        <field name="model">apunts.cmp.indicador</field>
        <field name="arch" type="xml">
            <list string="Índices de producción" create="0" delete="0" edit="0">
                <field name="semana" string="Sem"/>
                <field name="fecha" string="Lunes"/>
                <field name="horas_maquina" string="H. Máquina" sum="Total"/>
                <field name="horas_operario" string="H. Operario" sum="Total"/>
                <field name="horas_presencia" string="H. Presencia" sum="Total"/>
                <field name="macop" string="MACOP" decoration-success="macop &gt;= 1.25"
                       decoration-warning="macop &lt; 1.25 and macop &gt;= 1"/>
                <field name="macpre" string="MACPRE" decoration-success="macpre &gt;= 1.125"
                       decoration-warning="macpre &lt; 1.125 and macpre &gt;= 0.9"/>
                <field name="horas_previstas" string="H. Previstas" optional="show"/>
                <field name="productividad" string="Productividad"
                       decoration-success="productividad &gt;= 1"/>
                <field name="prevision_anual" string="Previsión horas año"/>
            </list>
        </field>
    </record>

    <record id="apunts_cmp_indicador_graph" model="ir.ui.view">
        <field name="name">apunts.cmp.indicador.graph</field>
        <field name="model">apunts.cmp.indicador</field>
        <field name="arch" type="xml">
            <graph string="Previsión de horas anuales" type="line" sample="1">
                <field name="fecha" interval="week"/>
                <field name="prevision_anual" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="apunts_action_cmp_indicadores" model="ir.actions.act_window">
        <field name="name">KPIs de producción</field>
        <field name="res_model">apunts.cmp.indicador</field>
        <field name="view_mode">list,graph</field>
        <field name="view_id" ref="apunts_cmp_indicador_list"/>
    </record>

    <record id="apunts_action_cmp_seguimiento" model="ir.actions.act_window">
        <field name="name">Seguimiento horario</field>
        <field name="res_model">apunts.cmp.indicador</field>
        <field name="view_mode">graph,list</field>
        <field name="view_id" ref="apunts_cmp_indicador_graph"/>
    </record>

</odoo>
