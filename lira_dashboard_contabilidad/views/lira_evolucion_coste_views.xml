<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_lira_evolucion_coste_graph" model="ir.ui.view">
    <field name="name">lira.evolucion.coste.line.graph</field>
    <field name="model">lira.evolucion.coste.line</field>
    <field name="arch" type="xml">
      <graph string="Evolución de costes" type="line" sample="1">
        <field name="mes_fecha" interval="month"/>
        <field name="concepto"/>
        <field name="importe" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="view_lira_evolucion_coste_pivot" model="ir.ui.view">
    <field name="name">lira.evolucion.coste.line.pivot</field>
    <field name="model">lira.evolucion.coste.line</field>
    <field name="arch" type="xml">
      <pivot string="Evolución de costes" sample="1">
        <field name="concepto" type="row"/>
        <field name="mes_fecha" interval="month" type="col"/>
        <field name="importe" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="view_lira_evolucion_coste_list" model="ir.ui.view">
    <field name="name">lira.evolucion.coste.line.list</field>
    <field name="model">lira.evolucion.coste.line</field>
    <field name="arch" type="xml">
      <list string="Evolución de costes" create="0" delete="0" edit="0"
            decoration-bf="concepto in ('total_costes','beneficio','facturacion')"
            decoration-danger="concepto == 'beneficio' and importe &lt; 0">
        <field name="mes" string="Mes"/>
        <field name="concepto" string="Concepto"/>
        <field name="importe" string="Importe (€)"/>
        <field name="pct" string="% s/ facturación"/>
        <field name="var_mes" string="Var. % vs mes ant."
               decoration-danger="var_mes &gt; 10 and concepto not in ('facturacion','beneficio')"
               decoration-success="concepto in ('facturacion','beneficio') and var_mes &gt; 0"/>
        <field name="secuencia" column_invisible="1"/>
        <field name="user_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="action_lira_evolucion_coste" model="ir.actions.server">
    <field name="name">Evolución de costes</field>
    <field name="model_id" ref="model_lira_evolucion_coste"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open()</field>
  </record>

  <menuitem id="menu_lira_evolucion_coste" name="Evolución de costes"
            parent="menu_lira_contabilidad_cat" sequence="1"
            action="action_lira_evolucion_coste"/>

<menuitem id="menu_lira_cuenta_bloque" name="⚙ Clasificación de costes"
            parent="menu_lira_contabilidad_cat" sequence="99"
            action="action_lira_cuenta_bloque"/>

</odoo>
