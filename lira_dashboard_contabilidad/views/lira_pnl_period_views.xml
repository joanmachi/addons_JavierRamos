<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ══ FORMULARIO P&G por Periodos ══════════════════════════════════════ -->
  <record id="view_lira_pnl_period_form" model="ir.ui.view">
    <field name="name">lira.pnl.period.form</field>
    <field name="model">lira.pnl.period</field>
    <field name="arch" type="xml">
      <form string="P&amp;G por Periodos" class="ld_form">
        <sheet>

          <div class="ld_header">
            <div class="ld_header_left">
              <div class="ld_main_title ld_title_row">P&amp;G por Periodos <widget name="lira_print_button" title="P&amp;G por Periodos" line_model="lira.pnl.line"/></div>
              <div class="ld_main_subtitle">
                Cuenta de resultados por bloques, con la clasificación de costes de la empresa:
                variables directos, semivariables, fijos operativos y estructura, más las
                amortizaciones y los financieros después del EBITDA. Cada bloque lleva su peso
                en % sobre la facturación.
              </div>
              <div class="ld_period_bar">
                <span class="fa fa-calendar-o ld_icon_muted"/>
                <field name="date_from" class="ld_date_input" nolabel="1"/>
                <span class="ld_sep">→</span>
                <field name="date_to" class="ld_date_input" nolabel="1"/>
                <button name="action_refresh" string="Actualizar" type="object"
                        class="ld_btn_primary" icon="fa-refresh"/>
                <button name="%(lira_dashboard_contabilidad.action_lira_cuenta_bloque)d"
                        string="⚙ Clasificación de costes" type="action"
                        class="btn btn-secondary ms-2" icon="fa-cogs"
                        title="Ver o cambiar a qué bloque pertenece cada cuenta de gasto"/>
              </div>
            </div>
            <div class="ld_header_kpis ld_pnl_kpis">
              <div class="ld_hkpi">
                <div class="ld_hkpi_label">Facturación
                  <i class="fa fa-info-circle text-muted ms-1" title="Ventas del periodo (cuentas 70x, sin IVA)."/></div>
                <div class="ld_hkpi_value" style="color:#16a34a"><field name="total_facturacion" readonly="1"/></div>
              </div>
              <div class="ld_hkpi_sep"/>
              <div class="ld_hkpi">
                <div class="ld_hkpi_label">Variables directos
                  <i class="fa fa-info-circle text-muted ms-1" title="Materia prima, subcontratas, tratamientos y transportes ligados directamente a los trabajos (clasificación de la empresa). Entre paréntesis, su peso sobre la facturación."/></div>
                <div class="ld_hkpi_value" style="color:#ca8a04"><field name="total_variables" readonly="1"/></div>
                <div class="ld_hkpi_trend"><field name="variables_pct" readonly="1"/>% s/facturación</div>
              </div>
              <div class="ld_hkpi_sep"/>
              <div class="ld_hkpi">
                <div class="ld_hkpi_label">Semivariables
                  <i class="fa fa-info-circle text-muted ms-1" title="Herramienta, reparaciones, electricidad y carburantes: crecen con la actividad pero no de forma proporcional."/></div>
                <div class="ld_hkpi_value" style="color:#d97706"><field name="total_semivariables" readonly="1"/></div>
                <div class="ld_hkpi_trend"><field name="semivariables_pct" readonly="1"/>% s/facturación</div>
              </div>
              <div class="ld_hkpi_sep"/>
              <div class="ld_hkpi">
                <div class="ld_hkpi_label">Fijos operativos
                  <i class="fa fa-info-circle text-muted ms-1" title="Personal, nave, rentings, seguros y servicios recurrentes: el coste de mantener la fábrica lista."/></div>
                <div class="ld_hkpi_value" style="color:#dc2626"><field name="total_fijos_op" readonly="1"/></div>
                <div class="ld_hkpi_trend"><field name="fijos_op_pct" readonly="1"/>% s/facturación</div>
              </div>
              <div class="ld_hkpi_sep"/>
              <div class="ld_hkpi">
                <div class="ld_hkpi_label">Estructura / Dirección
                  <i class="fa fa-info-circle text-muted ms-1" title="Dirección, asesores y administración: cuánto pesa la estructura sobre lo facturado."/></div>
                <div class="ld_hkpi_value" style="color:#7c3aed"><field name="total_estructura" readonly="1"/></div>
                <div class="ld_hkpi_trend"><field name="estructura_pct" readonly="1"/>% s/facturación</div>
              </div>
              <div class="ld_hkpi_sep"/>
              <div class="ld_hkpi">
                <div class="ld_hkpi_label">EBITDA
                  <i class="fa fa-info-circle text-muted ms-1" title="Facturación + otros ingresos + variación de existencias − los cuatro bloques de coste. Antes de amortizaciones y financieros."/></div>
                <div class="ld_hkpi_value"><field name="ebitda" readonly="1"/></div>
                <div class="ld_hkpi_trend"><field name="ebitda_pct" readonly="1"/>% s/facturación</div>
              </div>
              <div class="ld_hkpi_sep"/>
              <div class="ld_hkpi">
                <div class="ld_hkpi_label">Resultado
                  <i class="fa fa-info-circle text-muted ms-1" title="EBITDA − amortizaciones − gastos financieros. El resultado final del periodo."/></div>
                <div class="ld_hkpi_value"><field name="resultado" readonly="1"/></div>
                <div class="ld_hkpi_trend"><field name="resultado_pct" readonly="1"/>% s/facturación</div>
              </div>
            </div>
          </div>

          <!-- Partidas después del EBITDA y avisos -->
          <div class="ld_header_kpis" style="margin-top:12px">
            <div class="ld_hkpi">
              <div class="ld_hkpi_label">Otros ingresos</div>
              <div class="ld_hkpi_value" style="color:#16a34a"><field name="total_otros_ing" readonly="1"/></div>
            </div>
            <div class="ld_hkpi_sep"/>
            <div class="ld_hkpi">
              <div class="ld_hkpi_label">Variación de existencias</div>
              <div class="ld_hkpi_value"><field name="total_variacion" readonly="1"/></div>
            </div>
            <div class="ld_hkpi_sep"/>
            <div class="ld_hkpi">
              <div class="ld_hkpi_label">Amortizaciones</div>
              <div class="ld_hkpi_value" style="color:#dc2626"><field name="total_amortizaciones" readonly="1"/></div>
            </div>
            <div class="ld_hkpi_sep"/>
            <div class="ld_hkpi">
              <div class="ld_hkpi_label">Gastos financieros</div>
              <div class="ld_hkpi_value" style="color:#dc2626"><field name="total_financieros" readonly="1"/></div>
            </div>
            <div class="ld_hkpi_sep"/>
            <div class="ld_hkpi">
              <div class="ld_hkpi_label">Ingresos financieros</div>
              <div class="ld_hkpi_value" style="color:#16a34a"><field name="total_ing_financieros" readonly="1"/></div>
            </div>
            <div class="ld_hkpi_sep"/>
            <div class="ld_hkpi">
              <div class="ld_hkpi_label">Sin clasificar
                <i class="fa fa-info-circle text-muted ms-1" title="Gasto que no está en la clasificación de la empresa. Si crece, hay cuentas nuevas que decidir a qué bloque van."/></div>
              <div class="ld_hkpi_value" style="color:#dc2626"><field name="total_sin_clasificar" readonly="1"/></div>
            </div>
          </div>

          <div class="ld_cta_panel">
            <div class="ld_cta_icon"><i class="fa fa-list-ul"/></div>
            <div class="ld_cta_text">
              <strong>Ver detalle por cuenta</strong>
              <span>Abre la tabla agrupada por bloque (Ingresos/Variables/Fijos). Cada fila con acceso directo a los apuntes contables.</span>
            </div>
            <button name="action_ver_tabla" string="Ver detalle" type="object"
                    class="ld_btn_primary" icon="fa-search"/>
          </div>

          <div class="ld_cta_panel">
            <div class="ld_cta_icon"><i class="fa fa-line-chart"/></div>
            <div class="ld_cta_text">
              <strong>Ver evolución mensual</strong>
              <span>La misma cascada, mes a mes en el periodo elegido: tabla con los meses en columnas, gráficas por bloque y variación respecto al mes anterior.</span>
            </div>
            <button name="action_evolucion_mensual" string="Ver evolución" type="object"
                    class="ld_btn_primary" icon="fa-line-chart"/>
          </div>

        </sheet>
      </form>
    </field>
  </record>

  <!-- ══ LISTA lira.pnl.line ═══════════════════════════════════════════════ -->
  <record id="view_lira_pnl_line_list" model="ir.ui.view">
    <field name="name">lira.pnl.line.list</field>
    <field name="model">lira.pnl.line</field>
    <field name="arch" type="xml">
      <list string="P&amp;G — detalle por cuenta" create="0" delete="0" edit="0"
            decoration-success="bloque == 'ingresos'"
            decoration-warning="bloque == 'variables'"
            decoration-danger="bloque == 'fijos'">
        <field name="bloque" string="Bloque" widget="badge"
               decoration-success="bloque == 'ingresos'"
               decoration-warning="bloque == 'variables'"
               decoration-danger="bloque == 'fijos'"
               help="Ingresos (7xx) · Costes variables (7 cuentas marcadas por el contable) · Costes fijos (resto 6xx)."/>
        <field name="codigo_cuenta" string="Código"
               help="Código contable de la cuenta. Fuente: account.account.code."/>
        <field name="nombre_cuenta" string="Nombre"
               help="Nombre de la cuenta. Fuente: account.account.name."/>
        <field name="saldo" string="Saldo (€)" sum="Total saldo"
               help="Saldo de la cuenta en el periodo (ingresos o gastos según tipo)."/>
        <field name="pct_sobre_bloque" string="% s/bloque" avg="% medio"
               help="Porcentaje que representa esta cuenta sobre el total de su bloque."/>
        <field name="pct_sobre_ingresos" string="% s/ingresos" avg="% medio"
               help="Porcentaje sobre el total de ingresos. Útil para ver el peso relativo."/>
        <field name="date_from" optional="hide"/>
        <field name="date_to" optional="hide"/>
        <field name="account_id" column_invisible="1"/>
        <field name="user_id" column_invisible="1"/>
        <button name="action_open_source" type="object" icon="fa-external-link"
                string="Ver apuntes en Contabilidad"
                title="Abrir los apuntes contables de esta cuenta en el periodo analizado"/>
      </list>
    </field>
  </record>

  <!-- ══ BUSCADOR lira.pnl.line ═══════════════════════════════════════════ -->
  <record id="view_lira_pnl_line_search" model="ir.ui.view">
    <field name="name">lira.pnl.line.search</field>
    <field name="model">lira.pnl.line</field>
    <field name="arch" type="xml">
      <search string="Buscar en P&amp;G">
        <field name="codigo_cuenta" string="Código cuenta"/>
        <field name="nombre_cuenta" string="Nombre cuenta"/>
        <field name="account_id" string="Cuenta"/>
        <separator/>
        <filter name="bloque_ingresos"  string="Solo Ingresos"          domain="[('bloque','=','ingresos')]"/>
        <filter name="bloque_variables" string="Solo Costes variables"  domain="[('bloque','=','variables')]"/>
        <filter name="bloque_fijos"     string="Solo Costes fijos"      domain="[('bloque','=','fijos')]"/>
        <separator/>
        <filter name="saldo_pos"   string="Saldo &gt; 0"         domain="[('saldo','>',0)]"/>
        <filter name="saldo_1k"    string="Saldo &gt; 1.000 €"   domain="[('saldo','>',1000)]"/>
        <filter name="saldo_10k"   string="Saldo &gt; 10.000 €"  domain="[('saldo','>',10000)]"/>
        <filter name="peso_5"      string="Peso &gt; 5% del bloque" domain="[('pct_sobre_bloque','>',5)]"/>
        <filter name="peso_ing_5"  string="Peso &gt; 5% de ingresos" domain="[('pct_sobre_ingresos','>',5)]"/>
        <group expand="1" string="Agrupar por">
          <filter name="group_bloque"  string="Bloque"        context="{'group_by': 'bloque'}"/>
          <filter name="group_account" string="Cuenta"        context="{'group_by': 'account_id'}"/>
          <filter name="group_codigo"  string="Código cuenta" context="{'group_by': 'codigo_cuenta'}"/>
          <filter name="group_saldo"   string="Saldo"         context="{'group_by': 'saldo'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ══ ACCIÓN DEL MENÚ ═══════════════════════════════════════════════════ -->
  <record id="action_lira_pnl_period" model="ir.actions.server">
    <field name="name">P&amp;G por Periodos Lira</field>
    <field name="model_id" ref="model_lira_pnl_period"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open()</field>
  </record>

</odoo>
