<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_coste_of" model="ir.actions.report">
        <field name="name">Coste de OF</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">apunts_jr_wip_costes_of.report_coste_of</field>
        <field name="report_file">apunts_jr_wip_costes_of.report_coste_of</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Coste OF - %s' % (object.name or '')</field>
    </record>

    <template id="report_coste_of">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="mats" t-value="material[doc.id]"/>
                <t t-set="labs" t-value="labor[doc.id]"/>
                <t t-set="cur" t-value="doc.company_currency_id"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Cabecera -->
                        <h2 class="mt-0 mb-1">Coste de OF — <span t-field="doc.name"/></h2>
                        <table class="table table-sm table-borderless mb-3" style="width:100%;">
                            <tr>
                                <td style="width:25%;"><strong>Producto</strong></td>
                                <td style="width:40%;"><span t-field="doc.product_id.display_name"/></td>
                                <td style="width:15%;"><strong>Cantidad</strong></td>
                                <td style="width:20%;"><span t-field="doc.product_qty"/> <span t-field="doc.product_uom_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Cliente</strong></td>
                                <td><span t-esc="doc.apunts_partner_id.name or '—'"/></td>
                                <td><strong>Estado</strong></td>
                                <td><span t-field="doc.state"/></td>
                            </tr>
                        </table>

                        <!-- Tarjetas resumen (mismos campos que la pantalla) -->
                        <table class="table table-bordered text-center mb-3" style="width:100%;">
                            <thead>
                                <tr class="table-active">
                                    <th>Venta</th>
                                    <th>En curso (real)</th>
                                    <th>Coste teórico OF</th>
                                    <th>Margen actual</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="h4">
                                        <span t-field="doc.apunts_sale_amount"
                                              t-options="{'widget': 'monetary', 'display_currency': cur}"/>
                                    </td>
                                    <td class="h4">
                                        <span t-field="doc.apunts_cost_total_real"
                                              t-options="{'widget': 'monetary', 'display_currency': cur}"/>
                                    </td>
                                    <td class="h4">
                                        <span t-field="doc.apunts_cost_total_planned"
                                              t-options="{'widget': 'monetary', 'display_currency': cur}"/>
                                    </td>
                                    <td class="h4">
                                        <span t-field="doc.apunts_margin_total"
                                              t-options="{'widget': 'monetary', 'display_currency': cur}"/>
                                        <div class="small text-muted">
                                            Factor <span t-esc="'%.2f' % (doc.apunts_factor_cobertura or 0)"/>x ·
                                            Avance <span t-esc="'%.0f' % (doc.apunts_avance_coste_pct or 0)"/>%
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Desglose por concepto (teórico vs real) -->
                        <h4 class="mb-1">Desglose por concepto</h4>
                        <table class="table table-bordered mb-3" style="width:100%;">
                            <thead>
                                <tr class="table-active">
                                    <th>Concepto</th>
                                    <th class="text-end">Teórico</th>
                                    <th class="text-end">Real</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>MP (Materia Prima)</td>
                                    <td class="text-end"><span t-field="doc.apunts_mat_planned_total" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                                    <td class="text-end"><span t-field="doc.apunts_mat_real_total" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                                </tr>
                                <tr>
                                    <td>Tiempo de fabricación</td>
                                    <td class="text-end"><span t-field="doc.apunts_min_total_plan" t-options="{'widget': 'float_time'}"/></td>
                                    <td class="text-end"><span t-field="doc.apunts_min_real_total" t-options="{'widget': 'float_time'}"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">↳ Coste operario</td>
                                    <td class="text-end"><span t-field="doc.apunts_mo_planned_total" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                                    <td class="text-end"><span t-field="doc.apunts_mo_real_total" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                                </tr>
                                <tr>
                                    <td class="ps-4">↳ Coste máquina</td>
                                    <td class="text-end"><span t-field="doc.apunts_machine_planned_total" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                                    <td class="text-end"><span t-field="doc.apunts_machine_real_total" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                                </tr>
                                <tr t-if="doc.apunts_mat_servicio_externo">
                                    <td>Servicios externos</td>
                                    <td class="text-end text-muted">—</td>
                                    <td class="text-end"><span t-field="doc.apunts_mat_servicio_externo" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                                </tr>
                                <tr class="table-active">
                                    <td><strong>TOTAL</strong></td>
                                    <td class="text-end"><strong><span t-field="doc.apunts_cost_total_planned" t-options="{'widget': 'monetary', 'display_currency': cur}"/></strong></td>
                                    <td class="text-end"><strong><span t-field="doc.apunts_cost_total_real" t-options="{'widget': 'monetary', 'display_currency': cur}"/></strong></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Detalle de material -->
                        <h4 class="mb-1">Detalle de material</h4>
                        <table class="table table-sm table-bordered mb-3" style="width:100%;">
                            <thead>
                                <tr class="table-active">
                                    <th>Componente</th>
                                    <th class="text-end">Necesario</th>
                                    <th class="text-end">Coste (€)</th>
                                    <th class="text-end">Recibido prov. (€)</th>
                                    <th>Proveedor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="mats" t-as="m">
                                    <td><span t-esc="m.product_name"/></td>
                                    <td class="text-end"><span t-esc="'%.2f' % (m.qty_needed or 0)"/></td>
                                    <td class="text-end"><span t-field="m.cost_total_needed" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                                    <td class="text-end"><span t-field="m.cost_recibido" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                                    <td><span t-esc="m.seller_partner_name or ''"/></td>
                                </tr>
                                <tr t-if="not mats">
                                    <td colspan="5" class="text-center text-muted">Sin componentes.</td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Detalle de mano de obra -->
                        <h4 class="mb-1">Mano de obra y operaciones</h4>
                        <table class="table table-sm table-bordered" style="width:100%;">
                            <thead>
                                <tr class="table-active">
                                    <th>OT</th>
                                    <th>Centro</th>
                                    <th class="text-end">H. plan</th>
                                    <th class="text-end">H. real</th>
                                    <th class="text-end">Coste (€)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="labs" t-as="l">
                                    <td><span t-esc="l.workorder_name or ''"/></td>
                                    <td><span t-esc="l.workcenter_name or ''"/></td>
                                    <td class="text-end"><span t-field="l.hours_planned" t-options="{'widget': 'float_time'}"/></td>
                                    <td class="text-end"><span t-field="l.hours_real" t-options="{'widget': 'float_time'}"/></td>
                                    <td class="text-end"><span t-field="l.cost_total" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                                </tr>
                                <tr t-if="not labs">
                                    <td colspan="5" class="text-center text-muted">Sin operaciones.</td>
                                </tr>
                            </tbody>
                        </table>

                        <p class="text-muted small mt-3">
                            Los importes de este documento son los mismos que muestra la pantalla
                            «Coste OF» de esta orden.
                        </p>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
